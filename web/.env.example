# NextAuth.js — required for authentication
NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# Claude Vision OCR — required for prescription scanning
# Get your API key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the vision model (default: claude-sonnet-4-20250514)
# MEDICO_VISION_MODEL=claude-sonnet-4-20250514
