# Backend and frontend URLs
MEDICO_API_URL=http://localhost:8000/api/v1
MEDICO_HEALTH_URL=http://localhost:8000/health

# Optional cloud OCR for handwritten prescriptions.
# Required on Vercel because local Tesseract/EasyOCR binaries are unavailable there.
# Leave blank for local development if Tesseract/EasyOCR are installed.
GEMINI_API_KEY=
MEDICO_VISION_MODEL=gemini-2.5-flash

# Optional text LLM cleanup after OCR. Keep false for fully local NLP.
MEDICO_USE_LLM_NLP=false
MEDICO_TEXT_MODEL=gemini-2.5-flash
